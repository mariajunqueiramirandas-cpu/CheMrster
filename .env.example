# Copy to .env (Docker Compose / Dokploy's Environment tab) or .env.local (npm run dev).
# Without the Clerk keys the app runs as before: no accounts, data on the device only.

# The public URL the app is served from. Session tokens minted for any other site are refused.
APP_URL=https://chemrster.example.com
# More origins or host names, comma-separated (optional).
# APP_ORIGINS=https://www.chemrster.example.com
# ALLOWED_HOSTS=

# Clerk (dashboard.clerk.com → API keys). Use the pk_live_/sk_live_ pair in production.
CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
# Optional: the JWT public key (Clerk → API keys → Show JWT public key, PEM, \n for newlines)
# verifies session tokens without a request to Clerk.
# CLERK_JWT_KEY=
# Clerk → Webhooks → endpoint https://<your domain>/api/webhooks/clerk with the user.deleted
# event: a deleted account's saved data is deleted too. Optional.
CLERK_WEBHOOK_SIGNING_SECRET=

# The tutor's Claude API key; it stays on the server. Without it, learners can paste their own
# key in Ajustes, or use the offline tutor.
ANTHROPIC_API_KEY=

# Postgres. Compose builds DATABASE_URL from this password: use only letters, digits, - and _.
POSTGRES_PASSWORD=change-me-to-a-long-random-string
# Outside Compose (npm run dev / npm run serve), point at any Postgres, or leave unset to keep
# account data in memory.
# DATABASE_URL=postgres://chemrster:password@localhost:5432/chemrster

# Tutor requests per learner per day on the server's key (one answer can take a few when the
# tutor uses tools). Plus = Clerk Billing's Pro plan (feature tutor_ia_plus).
TUTOR_DAILY_LIMIT_FREE=20
TUTOR_DAILY_LIMIT_PLUS=400
QUOTA_TIME_ZONE=America/Sao_Paulo
# TUTOR_MODELS=claude-opus-5-5,claude-sonnet-5-5,claude-haiku-5-5
# TUTOR_MAX_TOKENS=32000
